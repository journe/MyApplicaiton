<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.CycleHeadActivity"
    >
  <com.jour.demo.view.CustomTextView
      android:id="@+id/customTextView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:text="哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈"
      app:textColor="#00ff00"
      app:textSize="14sp"
      />
  <com.jour.demo.view.CustomGroup
      android:id="@+id/customGroup"
      android:layout_width="match_parent"
      android:layout_height="66dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/customTextView"
      app:scaleWidth="10dp"
      />

  <com.jour.demo.view.CustomImageView
      android:id="@+id/customImageView"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="10dp"
      android:layout_marginTop="8dp"
      android:padding="10dp"
      app:imageScaleType="1"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/customGroup"
      app:titleText="hello andorid ! "
      app:titleTextColor="#ff0000"
      app:titleTextSize="30sp"
      />

  <com.jour.demo.view.ImageMoveView
      android:id="@+id/imageMoveView"
      android:layout_width="50dp"
      android:layout_height="50dp"
      android:layout_marginTop="32dp"
      android:scaleType="centerCrop"
      android:src="@drawable/ic_notification_logo"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/customImageView"
      app:layout_constraintTop_toTopOf="@+id/customImageView"
      />
  <com.jour.demo.view.TextMoveView
      android:id="@+id/textMoveView"
      android:layout_width="wrap_content"
      android:layout_height="30dp"
      android:layout_centerInParent="true"
      android:background="#00ff00"
      android:gravity="center"
      android:text="我是美女"
      app:layout_constraintEnd_toEndOf="@+id/imageMoveView"
      app:layout_constraintTop_toBottomOf="@+id/imageMoveView"
      />
  <com.jour.demo.view.CustomRingProgress
      android:id="@+id/customRingProgress"
      android:layout_width="100dp"
      android:layout_height="100dp"
      app:circleWidth="10dp"
      app:firstColor="#Fe4646"
      app:layout_constraintStart_toStartOf="@+id/customImageView"
      app:layout_constraintTop_toBottomOf="@+id/customImageView"
      app:secondColor="#00ff00"
      app:speed="10"
      />
  <com.jour.demo.view.CusVolumeView
      android:id="@+id/cusVolumeView"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_marginStart="16dp"
      app:layout_constraintStart_toEndOf="@+id/customRingProgress"
      app:layout_constraintTop_toTopOf="@+id/customRingProgress"
      />

  <com.jour.demo.view.ImageMoveScaleView
      android:id="@+id/imageMoveScaleView"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="19dp"
      android:layout_marginEnd="16dp"
      android:src="@drawable/default_album_art"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/textMoveView"
      />

  <eightbitlab.com.blurview.BlurView
      android:id="@+id/blurView"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_gravity="center"
      app:blurOverlayColor="#10000000"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/cusVolumeView"
      />
  <com.jour.demo.view.ImageMoveScaleGestureDetectorView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:layout_marginEnd="16dp"
      android:src="@drawable/img_main_2"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/imageMoveScaleView"
      />

  <com.jour.demo.view.EdgeTransparentView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:edge_position="top"
      app:edge_width="30dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      >
    <com.jour.demo.view.MultiTouchGestureView
        android:id="@+id/multiTouchGestureView"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:background="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
  </com.jour.demo.view.EdgeTransparentView>
</androidx.constraintlayout.widget.ConstraintLayout>